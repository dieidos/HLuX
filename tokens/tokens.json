    "ink": "#0d1117",
    "text": "#343e51",
    "slate": "#5b6577",
    "muted": "#565f6f",
    "line": "#dfe3ea",
    "violet": { "value": "#8c6aa8", "ink": "#6d4f88" },
    "night": "#2d1d3d",
    "lavender": "#cfafe7",
    "yellow": { "value": "#ffd966", "ink": "#705f2c" },
    "blue": { "value": "#8faadc", "ink": "#3f5a90" },
    "green": { "value": "#a9d18e", "ink": "#46573b" },
    "coral": "#f08a7e",
    "pp": { "value": "#ffd966", "ink": "#705f2c", "soft": "#fff6d6" },
    "pe": { "value": "#a9d18e", "ink": "#46573b", "soft": "#eef7e7" },
    "logo": { "first": "#ffd965", "second": "#8faadc", "third": "#a9d18e" },
    "feeling": { "fine": "#eef7e7", "unsure": "#fff6d6", "hard": "#fde7e4" }
