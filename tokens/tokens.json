  "contrast": [
    ["text", "bg"], ["ink", "surface"], ["muted", "bg"], ["slate", "surface"],
    ["violet.ink", "surface"], ["yellow.ink", "pp.soft"], ["green.ink", "pe.soft"], ["blue.ink", "surface"],
    ["surface", "violet.ink"], ["surface", "night"]
