{
  "expo": {
    "name": "HLuX",
    "slug": "hlux",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "io.dieidos.hlux"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "io.dieidos.hlux"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "bundler": "metro"
    },
    "scheme": "hlux",
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-localization",
      "expo-sharing",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "La caméra lit les codes QR qui copient ton dossier d'un appareil à l'autre. Aucune image n'est gardée.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Le micro sert à dicter une phrase. La voix est reconnue sur l'appareil et n'est jamais enregistrée.",
          "speechRecognitionPermission": "La reconnaissance de la parole se fait sur l'appareil, pour écrire ce que tu dis. Rien n'est gardé ni envoyé."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
